
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY CloudSentinel.Core/ CloudSentinel.Core/
COPY CloudSentinel.Functions/ CloudSentinel.Functions/
RUN dotnet publish CloudSentinel.Functions/CloudSentinel.Functions.csproj -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV PORT=8080
ENV ASPNETCORE_URLS=http://+:8080
ENV FUNCTION_TARGET=CloudSentinel.Functions.MonitoringFunction
ENTRYPOINT ["dotnet", "CloudSentinel.Functions.dll"]
